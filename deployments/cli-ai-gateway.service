[Unit]
Description=CLI AI Gateway (OpenAI-compatible API for CLI AI agents and Ollama)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cli-gateway
Group=cli-gateway
WorkingDirectory=/var/lib/cli-gateway
ExecStart=/usr/local/bin/cli-ai-gateway -config /etc/cli-ai-gateway/config.yaml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=35s

# Isolation and hardening (Section 11.3 & 15)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/cli-gateway

# Resource limits
LimitNOFILE=65536
MemoryMax=2G
CPUQuota=200%

[Install]
WantedBy=multi-user.target
