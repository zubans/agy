# Network binding on host (use 0.0.0.0 carefully only behind TLS/firewall)
GATEWAY_BIND_HOST=127.0.0.1
GATEWAY_PORT=8080

# Auto-generated by `make init` (replace before production deployment)
GATEWAY_API_KEY=gw-dev-change-me
GATEWAY_ADMIN_TOKEN=gw-admin-change-me
GATEWAY_WORKER_TOKEN=gw-worker-change-me

# Optional remote Ollama server on another host or LAN machine
# GATEWAY_OLLAMA_BASE_URL=http://10.0.0.50:11434
# GATEWAY_OLLAMA_MODEL=qwen3

GATEWAY_LOG_LEVEL=info
